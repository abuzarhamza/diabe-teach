{
  "name": "diabe-teach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:debug": "DEBUG=* netlify dev",
    "dev:local": "node --import tsx scripts/start-dev-with-mongodb.ts",
    "dev:prototype": "node --import tsx scripts/start-dev-with-mongodb.ts --no-api-key",
    "dev:local:stop": "node --import tsx scripts/stop-dev-local.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "node --import tsx scripts/run-bdd-sequential.ts",
    "test:bdd:mongodb": "BDD_USE_MONGODB=true node --import tsx scripts/run-bdd-sequential.ts",
    "test:all": "npm run test && npm run test:bdd",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src netlify scripts tests",
    "lint:fix": "eslint src netlify scripts tests --fix",
    "lint:boundaries": "depcruise src netlify web/src --config .dependency-cruiser.cjs",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "typecheck:web": "npm --prefix web run typecheck",
    "lint:web": "npm --prefix web run lint",
    "db:seed": "node --experimental-strip-types scripts/seed-curriculum-packs.ts",
    "complexity": "node --experimental-strip-types scripts/run-complexity.ts",
    "escomplex": "node --experimental-strip-types scripts/run-complexity.ts",
    "prepare": "husky",
    "generate:request-schemas": "node --import tsx scripts/generate-request-schemas.ts",
    "generate:api-docs": "node --import tsx scripts/generate-bruno-api-docs.ts"
  },
  "dependencies": {
    "@middy/core": "^7.9.2",
    "@middy/http-json-body-parser": "^7.9.2",
    "@netlify/functions": "^3.1.2",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "mongodb": "^6.13.0",
    "mongoose": "^9.11.4",
    "path-to-regexp": "^8.4.2",
    "pino": "^10.4.0",
    "seedrandom": "^3.0.5",
    "semver": "^7.8.6",
    "word-count": "^0.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@apidevtools/json-schema-ref-parser": "^16.0.8",
    "@cucumber/cucumber": "^13.3.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/chai": "^5.2.3",
    "@types/node": "^22.13.0",
    "@types/seedrandom": "^3.0.8",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@types/yaml": "^1.9.6",
    "@usebruno/cli": "^4.3.0",
    "@usebruno/lang": "^0.41.0",
    "@vitest/coverage-v8": "^3.0.5",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "dependency-cruiser": "^16.10.0",
    "escomplex": "^2.0.0-alpha",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "mongodb-memory-server": "^11.3.0",
    "netlify-cli": "^27.16.2",
    "pino-pretty": "^13.2.0",
    "smol-toml": "^1.9.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
