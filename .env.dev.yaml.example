# Example local development configuration.
# Copy this file to .env.dev.yaml (gitignored) and fill in your own values.
# Never commit real values. Each key can also be set by an environment
# variable, which wins over this file (shown in brackets).

mongodb:
  # [MONGODB_URI] Leave empty to fall back to in-memory repositories,
  # or use `npm run dev:local` for an in-memory MongoDB.
  uri: "mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority"
  # [MONGODB_DB_NAME] Defaults to diabe_teach when omitted.
  database: "concept_chain_dev"

auth:
  # [CAPABILITY_TOKEN_SECRET] Signs Capability Tokens. Without it, an
  # in-memory fake is used. Generate with: openssl rand -hex 32
  capability_token_secret: "<random-capability-token-secret>"
  # [ACCOUNT_TOKEN_SECRET] Signs Account Tokens (teacher sign-in). Keep it
  # different from the capability secret. Without it, an in-memory fake is used.
  account_token_secret: "<random-account-token-secret>"
  # [API_KEY] Required as the x-api-key header on pack routes when set.
  api_key: "<random-api-key>"

logging:
  # [LOG_LEVEL] Minimum level written: trace, debug, info, warn, error, fatal,
  # or silent. Defaults to "debug" under `netlify dev` (`NETLIFY_DEV=true`),
  # "info" when deployed, and "silent" in vitest and the BDD runner.
  # Any unknown value falls back to "info" and logs one warning naming it.
  level: "debug"
  # [LOG_PRETTY] Human-readable coloured output via pino-pretty (sync stream).
  # Defaults to true under `netlify dev` and false elsewhere; ignored outside
  # `netlify dev` so deployed functions always emit one JSON object per line.
  pretty: true

