meta {
  name: Adjudicate Concept Chain
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}/rounds/{{roundNumber}}/chains/{{chainId}}/adjudicate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{instructorToken}}
}

body:json {
  {
    "action": "instructor-approve",
    "qualityScore": 8,
    "feedback": "Clear mechanistic narrative linking insulin resistance, GLUT4 translocation, and beta-cell compensation."
  }
}

tests {
  test("records the Instructor Final Ruling and locks the chain verdict", function() {
    expect(res.status).to.equal(200);
    expect(res.body.chain.status).to.equal("approved");
    expect(res.body.chain.verdict.isLocked).to.equal(true);
  });
}

docs {
  # POST /api/v1/sessions/:sessionId/rounds/:roundNumber/chains/:chainId/adjudicate (`adjudicateConceptChain`)

  Records either a learner's peer vote or an **Instructor Final Ruling** on Concept Chain `{{chainId}}`.

  ## Discriminated Request Payloads (`action`)
  1. **Instructor Final Ruling** (requires `{{instructorToken}}`, permanently locks `chain.verdict.isLocked = true`):
     ```json
     {
       "action": "instructor-approve",
       "qualityScore": 8,
       "feedback": "Sound mechanistic rationale across all four cards."
     }
     ```
     *(or `"action": "instructor-reject"` with required non-empty `"feedback"` and optional `"qualityScore"` `1..10`)*
  2. **Learner Peer Vote** (use `{{participantToken}}` or `{{instructorToken}}` before the chain is locked):
     ```json
     {
       "action": "peer-approve",
       "reason": "Consecutive cards are physiologically connected."
     }
     ```
     *(or `"action": "peer-reject"`)*

  ## Responses & Error Codes (`ApiErrorCode`)
  - **`200 OK`**: `{ chain: SubmittedChain }`
  - **`400 INVALID_REQUEST_BODY`**: Unknown `action`, missing/empty `feedback` on an instructor ruling, or `qualityScore` outside `1..10`.
  - **`401 UNAUTHORIZED_TOKEN`**: Missing or invalid Capability Token.
  - **`403 FORBIDDEN_ROLE`**: A `participant` attempted `instructor-approve` or `instructor-reject`, or token belongs to another session.
  - **`403 PARTICIPANT_HAS_LEFT`**: Learner has left the Game Session.
  - **`404 SESSION_NOT_FOUND`** / **`404 CHAIN_NOT_FOUND`**: Unknown `sessionId` or `chainId`.
  - **`409 ADJUDICATION_LOCKED_BY_INSTRUCTOR`**: Chain verdict is already locked by an Instructor Final Ruling.
  - **`413 PAYLOAD_TOO_LARGE`**: Request body exceeds 256 KB.
}
