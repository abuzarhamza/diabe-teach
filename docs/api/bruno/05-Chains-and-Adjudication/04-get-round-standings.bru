meta {
  name: Get Round Standings
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}/rounds/{{roundNumber}}/standings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{instructorToken}}
}

tests {
  test("returns sorted Gameplay Round standings", function() {
    expect(res.status).to.equal(200);
    expect(res.body.standings).to.be.an("array");
  });
}

docs {
  # GET /api/v1/sessions/:sessionId/rounds/:roundNumber/standings (`getRoundStandings`)

  Returns the participant leaderboard (`rank`, `participantId`, `displayName`, `longestValidChainLength`, `approvedChainCount`, `totalSubmittedChains`) for Gameplay Round `:roundNumber`.

  ## Authentication
  - **`BearerAuth`**: `Authorization: Bearer {{instructorToken}}` or `{{participantToken}}` belonging to this `sessionId`.

  ## Responses & Error Codes (`ApiErrorCode`)
  - **`200 OK`**: `{ sessionId, roundNumber, standings: RoundStandingEntry[] }`
  - **`401 UNAUTHORIZED_TOKEN`**: Missing or invalid Capability Token.
  - **`403 FORBIDDEN_ROLE`**: Token belongs to another Game Session.
  - **`404 SESSION_NOT_FOUND`**: Unknown `sessionId`.
}
