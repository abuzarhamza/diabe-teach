meta {
  name: End Game Session
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}/end
  body: none
  auth: bearer
}

auth:bearer {
  token: {{instructorToken}}
}

tests {
  test("ends the Game Session and moves it to completed", function() {
    expect(res.status).to.equal(200);
    expect(res.body.state.phase).to.equal("completed");
  });
}

docs {
  # POST /api/v1/sessions/:sessionId/end (`endGameSession`)

  Immediately terminates a **Game Session** from any active phase and transitions it to `completed`, clearing any phase timer extension.

  ## Authentication
  - **`BearerAuth` (`role: "instructor"`)**: `Authorization: Bearer {{instructorToken}}`

  ## Responses & Error Codes (`ApiErrorCode`)
  - **`200 OK`**: `{ previousPhase, state }` (`state.phase === "completed"`)
  - **`401 UNAUTHORIZED_TOKEN`**: Missing or invalid Capability Token.
  - **`403 FORBIDDEN_ROLE`**: Caller is a `participant` or holds a token for another session.
  - **`404 SESSION_NOT_FOUND`**: Unknown `sessionId`.
  - **`409 SESSION_ALREADY_COMPLETED`**: Session is already in the `completed` phase.
}
