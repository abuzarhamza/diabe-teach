meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

tests {
  test("returns 200 ok", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
  });
}

docs {
  # GET /api/health

  Lightweight liveness/readiness endpoint that requires no authentication and returns `{ "status": "ok" }`.

  ## Responses
  - **`200 OK`**: `{ "status": "ok" }`
}
