        "summary": "Anabolic peptide hormone secreted by pancreatic beta cells."
      },
      {
        "id": "card-glucagon",
        "verbatimLabel": "Glucagon",
        "displayLabel": "Glucagon",
        "aliases": [],
        "domainId": "hormones",
        "summary": "Counter-regulatory hormone secreted by pancreatic alpha cells."
      },
      {
        "id": "card-beta-cell",
        "verbatimLabel": "Pancreatic Beta Cell",
        "displayLabel": "Beta Cell",
        "aliases": [],
        "domainId": "hormones",
        "summary": "Endocrine islet cell that senses glucose and releases insulin."
      },
      {
        "id": "card-glut4",
        "verbatimLabel": "GLUT4 Transporter",
        "displayLabel": "GLUT4",
        "aliases": [],
        "domainId": "metabolism",
        "summary": "Insulin-regulated glucose transporter in skeletal muscle and adipose tissue."
      },
      {
        "id": "card-glycogenolysis",
        "verbatimLabel": "Hepatic Glycogenolysis",
        "displayLabel": "Glycogenolysis",
        "aliases": [],
        "domainId": "metabolism",
        "summary": "Breakdown of stored hepatic glycogen into glucose."
      },
      {
        "id": "card-gluconeogenesis",
        "verbatimLabel": "Hepatic Gluconeogenesis",
        "displayLabel": "Gluconeogenesis",
        "aliases": [],
        "domainId": "metabolism",
        "summary": "Synthesis of glucose from non-carbohydrate precursors in the liver."
      },
      {
        "id": "card-hyperglycemia",
        "verbatimLabel": "Hyperglycemia",
        "displayLabel": "Hyperglycemia",
        "aliases": [],
        "domainId": "metabolism",
        "summary": "Elevated blood glucose concentration due to relative or absolute insulin deficiency."
      },
      {
        "id": "card-insulin-receptor",
        "verbatimLabel": "Insulin Receptor Tyrosine Kinase",
        "displayLabel": "Insulin Receptor",
        "aliases": [],
        "domainId": "hormones",
        "summary": "Transmembrane receptor activated by insulin binding."
      },
      {
        "id": "card-ampk",
        "verbatimLabel": "AMP-Activated Protein Kinase",
        "displayLabel": "AMPK",
        "aliases": [],
        "domainId": "metabolism",
        "summary": "Cellular energy sensor that stimulates glucose uptake and fatty acid oxidation."
      }
