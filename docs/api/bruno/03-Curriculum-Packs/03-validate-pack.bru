meta {
  name: Validate Curriculum Pack
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/packs/validate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accountToken}}
}

body:json {
