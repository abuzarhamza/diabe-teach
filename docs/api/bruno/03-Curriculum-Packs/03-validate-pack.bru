    "adjudicationRubric": {
      "evaluatorPersona": "Academic endocrinologist evaluating mechanistic concept chains",
      "subjectDomain": "Endocrinology and Glucose Homeostasis",
      "chainContinuityCriteria": [
        "Each consecutive pair of Keyword Cards must have a direct physiological or biochemical causal link."
      ],
      "calibrationExamples": []
    },
    "assessmentInstrument": null,
    "perceptionSurvey": null
  }
}

tests {
  test("dry-run validates the Curriculum Pack and returns valid: true", function() {
    expect(res.status).to.equal(200);
    expect(res.body.valid).to.equal(true);
    expect(res.body.errors).to.be.an("array");
  });
}

docs {
  # POST /api/v1/packs/validate (`validateCurriculumPack`)

  Performs a dry-run validation of a draft **Curriculum Pack** without persisting it, checking semantic domain references, board capacity (`cards.length >= rows * cols`), calibration examples, and optional assessment/survey instruments.

  ## Authentication
  - **`AccountAuth`**: `Authorization: Bearer {{accountToken}}`

  ## Responses & Error Codes (`ApiErrorCode`)
  - **`200 OK`**: `{ valid: boolean, errors: ValidationError[], warnings: ValidationWarning[] }`
  - **`400 INVALID_REQUEST_BODY`**: Missing required top-level schema field or wrong property type.
  - **`401 UNAUTHORIZED_TOKEN`**: Missing, invalid, or non-Account bearer token.
  - **`413 PAYLOAD_TOO_LARGE`**: Request body exceeds 256 KB.
}
