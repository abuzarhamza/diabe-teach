        "label": "Hormones & Signaling",
        "description": "Endocrine hormones and receptor pathways"
      },
      {
        "id": "metabolism",
        "label": "Glucose Metabolism",
        "description": "Hepatic and peripheral glucose uptake"
      }
    ],
    "cards": [
      {
        "id": "card-insulin",
        "verbatimLabel": "Insulin",
        "displayLabel": "Insulin",
        "aliases": [],
