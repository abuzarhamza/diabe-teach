meta {
  name: Extend Session Phase
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}/phase/extend
  body: json
  auth: bearer
}

auth:bearer {
  token: {{instructorToken}}
}

body:json {
  {
    "seconds": 60
  }
}

tests {
  test("extends the current timed phase deadline by 60 seconds", function() {
    expect(res.status).to.equal(200);
    expect(res.body.state.phaseEndsAt).to.be.a("string");
  });
}

docs {
  # POST /api/v1/sessions/:sessionId/phase/extend (`extendSessionPhase`)

  Adds `seconds` (`1..600`) to the current phase's deadline (`phaseEndsAt`). If a timed Chain-Mapping phase had already expired, extending it re-opens submissions until the new deadline (+ 5-second grace period).

  ## Authentication
  - **`BearerAuth` (`role: "instructor"`)**: `Authorization: Bearer {{instructorToken}}`

  ## Responses & Error Codes (`ApiErrorCode`)
  - **`200 OK`**: `{ state: PublicSessionState }`
  - **`400 INVALID_REQUEST_BODY`**: `seconds` is missing, non-integer, `< 1`, or `> 600`.
  - **`401 UNAUTHORIZED_TOKEN`**: Missing or invalid Capability Token.
  - **`403 FORBIDDEN_ROLE`**: Caller is a `participant` or holds a token for another session.
  - **`404 SESSION_NOT_FOUND`**: Unknown `sessionId`.
  - **`409 PHASE_HAS_NO_TIMER`**: Current phase is instructor-driven (`phaseEndsAt: null`).
  - **`409 SESSION_ALREADY_COMPLETED`**: Session is already in the `completed` phase.
  - **`413 PAYLOAD_TOO_LARGE`**: Request body exceeds 256 KB.
}
